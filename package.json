{
  "name": "nexus-office-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/web",
    "start": "npm run start --workspace apps/web",
    "lint": "npm run lint --workspace apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "cli": "npm run dev --workspace @nexus-office/cli",
    "assets": "npm run assets --workspace apps/web",
    "test": "node --experimental-strip-types --import ./tests/register-loader.mjs --test \"tests/*.test.mjs\"",
    "check:vercel": "node scripts/check-vercel-config.mjs",
    "prepare": "node scripts/setup-hooks.mjs"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20"
  }
}
