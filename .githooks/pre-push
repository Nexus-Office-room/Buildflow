#!/bin/sh
# Pre-push guard: refuse the push when the Vercel deployment config can't
# match the app location. This is the guard for the Root Directory drift that
# broke production after the Addendum 17 monorepo move (see TESTING.md →
# Deployment → "Vercel Root Directory / workspace build (monorepo)").
#
# Repo checks always run; dashboard checks activate when VERCEL_TOKEN and
# VERCEL_PROJECT_ID are set. A missing/unreachable token only warns here —
# push proceeds — but a verified mismatch fails the push.
node scripts/check-vercel-config.mjs || exit 1
