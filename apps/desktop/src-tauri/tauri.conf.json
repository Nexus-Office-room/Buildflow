{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Buildflow",
  "version": "0.1.2",
  "identifier": "com.buildflow.desktop",
  "build": {
    "frontendDist": "https://nexus-office-pi.vercel.app/"
  },
  "app": {
    "windows": [
      {
        "title": "Buildflow",
        "width": 1440,
        "height": 920,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "dmg", "msi", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
