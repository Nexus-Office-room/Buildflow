{
  "name": "@buildflow/cli",
  "version": "0.1.0",
  "description": "Buildflow CLI \u2014 your 5-role AI team in the terminal.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "buildflow": "./bin/nexus.js",
    "nexus": "./bin/nexus.js"
  },
  "files": [
    "bin",
    "dist/cli.cjs"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --noEmit && esbuild src/cli.ts --bundle --platform=node --format=cjs --target=node20 --outfile=dist/cli.cjs",
    "dev": "npm run build && node bin/nexus.js",
    "start": "node bin/nexus.js",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@nexus-office/api-client": "*",
    "@nexus/github-sync": "*",
    "@nexus/pipeline-types": "*",
    "commander": "^14.0.0",
    "esbuild": "^0.28.2",
    "@types/node": "^20",
    "typescript": "^5"
  }
}
